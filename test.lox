class Doughnut {
    cook() {
        print "Dunk in the fryer.";
        this.finish("sprinkles");
    }

    finish(ingredient) {
        print "Finish with " + ingredient + ".";
    }
}

class Crueller < Doughnut {
    finish(_ingredient) {
        super.finish("icing");
    }
}

var obj = Crueller();
obj.cook();
